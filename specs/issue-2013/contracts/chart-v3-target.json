{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Chart Block Attributes (v3 - Target)",
	"description": "Target schema with id at root level",
	"type": "object",
	"required": ["_version", "id", "io"],
	"properties": {
		"_version": {
			"type": "string",
			"const": "v3",
			"description": "Block version identifier"
		},
		"id": {
			"type": "string",
			"pattern": "^[a-f0-9-]+-chart$",
			"description": "Chart ID derived from controller (MOVED TO ROOT IN V3)"
		},
		"layout": {
			"type": "object",
			"description": "Chart layout configuration"
		},
		"metadata": {
			"type": "object",
			"description": "Chart metadata (title, subtitle, etc.)"
		},
		"io": {
			"type": "object",
			"properties": {
				"parentClass": {
					"type": "string"
				},
				"isConvertedChart": {
					"type": "boolean"
				},
				"isStaticChart": {
					"type": "boolean"
				},
				"isFreeformChart": {
					"type": "boolean"
				},
				"chartData": {
					"type": "array",
					"items": {
						"type": "object"
					}
				},
				"availableCategories": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"independentVariable": {
					"type": "string"
				}
			},
			"description": "IO object no longer contains id property"
		},
		"_legacy": {
			"type": "object",
			"description": "Preserved legacy attributes"
		},
		"_v1Original": {
			"type": "object",
			"description": "Original v1 attributes if migrated from v1"
		},
		"_v2Original": {
			"type": "object",
			"description": "Original v2 attributes if migrated from v2"
		},
		"_migrationMeta": {
			"type": "object",
			"properties": {
				"migratedAt": {
					"type": "string",
					"format": "date-time"
				},
				"migrationVersion": {
					"type": "string"
				},
				"migratedFrom": {
					"type": "string",
					"enum": ["v1", "v2"],
					"description": "Which version this was migrated from"
				}
			}
		}
	}
}
