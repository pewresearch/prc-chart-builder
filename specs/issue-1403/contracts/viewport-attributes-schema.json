{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Viewport-Specific Chart Attributes Schema",
	"description": "JSON Schema for chart block attributes with viewport-specific overrides for mobile and tablet devices",
	"type": "object",
	"properties": {
		"_version": {
			"type": "string",
			"enum": ["v1", "v2"],
			"description": "Block attribute schema version"
		},
		"id": {
			"type": "string",
			"description": "Unique chart identifier (at root level, see issue-2013)"
		},
		"layout": {
			"$ref": "#/definitions/LayoutObject"
		},
		"metadata": {
			"$ref": "#/definitions/MetadataObject"
		},
		"labels": {
			"$ref": "#/definitions/LabelObject"
		},
		"legend": {
			"$ref": "#/definitions/LegendObject"
		},
		"mobile": {
			"$ref": "#/definitions/ViewportAttributes",
			"description": "Mobile viewport overrides (< 768px)"
		},
		"tablet": {
			"$ref": "#/definitions/ViewportAttributes",
			"description": "Tablet viewport overrides (768px - 1024px)"
		}
	},
	"required": ["_version", "id"],
	"definitions": {
		"ViewportAttributes": {
			"type": "object",
			"description": "Viewport-specific attribute overrides. Any property present overrides the default attribute. Missing properties fallback to default.",
			"properties": {
				"layout": {
					"$ref": "#/definitions/PartialLayoutObject"
				},
				"metadata": {
					"$ref": "#/definitions/PartialMetadataObject"
				},
				"labels": {
					"$ref": "#/definitions/PartialLabelObject"
				},
				"legend": {
					"$ref": "#/definitions/PartialLegendObject"
				},
				"independentAxis": {
					"type": "object",
					"description": "Partial X-axis configuration"
				},
				"dependentAxis": {
					"type": "object",
					"description": "Partial Y-axis configuration"
				},
				"tooltip": {
					"type": "object",
					"description": "Partial tooltip configuration"
				},
				"bar": {
					"type": "object",
					"description": "Partial bar chart configuration"
				},
				"line": {
					"type": "object",
					"description": "Partial line chart configuration"
				},
				"map": {
					"type": "object",
					"description": "Partial map configuration"
				},
				"pie": {
					"type": "object",
					"description": "Partial pie chart configuration"
				},
				"dataRender": {
					"type": "object",
					"description": "Partial data rendering configuration"
				},
				"plotBands": {
					"type": "object",
					"description": "Partial plot bands configuration"
				},
				"annotations": {
					"type": "object",
					"description": "Partial annotations configuration"
				}
			},
			"additionalProperties": false
		},
		"LayoutObject": {
			"type": "object",
			"properties": {
				"width": {
					"type": "number",
					"description": "Chart width in pixels"
				},
				"height": {
					"type": "number",
					"description": "Chart height in pixels"
				},
				"type": {
					"type": "string",
					"enum": [
						"bar",
						"line",
						"area",
						"pie",
						"scatter",
						"map-usa",
						"diverging-bar"
					],
					"description": "Chart type"
				},
				"orientation": {
					"type": "string",
					"enum": ["vertical", "horizontal"],
					"description": "Chart orientation"
				},
				"overflowX": {
					"type": "string",
					"enum": ["scroll-fixed-y-axis", "responsive", "scroll"],
					"description": "Horizontal overflow handling"
				}
			}
		},
		"PartialLayoutObject": {
			"type": "object",
			"description": "Partial layout configuration for viewport override",
			"properties": {
				"width": {
					"type": "number"
				},
				"height": {
					"type": "number"
				},
				"orientation": {
					"type": "string",
					"enum": ["vertical", "horizontal"]
				},
				"overflowX": {
					"type": "string",
					"enum": ["scroll-fixed-y-axis", "responsive", "scroll"]
				}
			}
		},
		"MetadataObject": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"description": "Chart title"
				},
				"subtitle": {
					"type": "string",
					"description": "Chart subtitle"
				},
				"note": {
					"type": "string",
					"description": "Chart note"
				},
				"source": {
					"type": "string",
					"description": "Data source"
				}
			}
		},
		"PartialMetadataObject": {
			"type": "object",
			"description": "Partial metadata configuration for viewport override",
			"properties": {
				"title": {
					"type": "string"
				},
				"subtitle": {
					"type": "string"
				}
			}
		},
		"LabelObject": {
			"type": "object",
			"properties": {
				"active": {
					"type": "boolean",
					"description": "Whether data labels are visible"
				},
				"fontSize": {
					"type": "number",
					"description": "Label font size in pixels"
				},
				"fontWeight": {
					"type": "number",
					"description": "Label font weight"
				},
				"color": {
					"type": "string",
					"enum": ["inherit", "contrast", "black", "white"],
					"description": "Label color"
				},
				"labelPositionBar": {
					"type": "string",
					"enum": ["inside", "outside", "center"],
					"description": "Label position for bar charts"
				}
			}
		},
		"PartialLabelObject": {
			"type": "object",
			"description": "Partial label configuration for viewport override",
			"properties": {
				"active": {
					"type": "boolean"
				},
				"fontSize": {
					"type": "number"
				},
				"fontWeight": {
					"type": "number"
				},
				"color": {
					"type": "string",
					"enum": ["inherit", "contrast", "black", "white"]
				}
			}
		},
		"LegendObject": {
			"type": "object",
			"properties": {
				"active": {
					"type": "boolean",
					"description": "Whether legend is visible"
				},
				"orientation": {
					"type": "string",
					"enum": ["row", "column", "row-reverse", "column-reverse"],
					"description": "Legend layout direction"
				},
				"alignment": {
					"type": "string",
					"enum": ["flex-start", "flex-end", "center", "none"],
					"description": "Legend alignment"
				},
				"title": {
					"type": "string",
					"description": "Legend title"
				}
			}
		},
		"PartialLegendObject": {
			"type": "object",
			"description": "Partial legend configuration for viewport override",
			"properties": {
				"active": {
					"type": "boolean"
				},
				"orientation": {
					"type": "string",
					"enum": ["row", "column", "row-reverse", "column-reverse"]
				},
				"alignment": {
					"type": "string",
					"enum": ["flex-start", "flex-end", "center", "none"]
				}
			}
		}
	},
	"examples": [
		{
			"description": "Chart with mobile label override",
			"_version": "v2",
			"id": "example-chart-1",
			"layout": {
				"width": 800,
				"height": 400,
				"type": "bar"
			},
			"labels": {
				"active": true,
				"fontSize": 14
			},
			"mobile": {
				"labels": {
					"active": false
				}
			}
		},
		{
			"description": "Chart with responsive sizing for all viewports",
			"_version": "v2",
			"id": "example-chart-2",
			"layout": {
				"width": 800,
				"height": 500
			},
			"mobile": {
				"layout": {
					"width": 400,
					"height": 300
				}
			},
			"tablet": {
				"layout": {
					"width": 600,
					"height": 400
				}
			}
		},
		{
			"description": "Chart with complex mobile overrides",
			"_version": "v2",
			"id": "example-chart-3",
			"layout": {
				"width": 800,
				"height": 600
			},
			"labels": {
				"active": true
			},
			"legend": {
				"active": true,
				"orientation": "row"
			},
			"mobile": {
				"layout": {
					"width": 400,
					"height": 400
				},
				"labels": {
					"active": false
				},
				"legend": {
					"orientation": "column"
				}
			}
		}
	]
}
