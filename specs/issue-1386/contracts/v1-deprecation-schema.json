{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://pewresearch.org/schemas/chart-block-v1-deprecation.json",
	"title": "Chart Block v1 Deprecation Schema",
	"description": "Defines the structure and contract for the WordPress block deprecation that migrates flat attributes (v1) to nested attributes (v2)",
	"type": "object",
	"required": ["attributes", "supports", "save", "migrate"],
	"properties": {
		"attributes": {
			"description": "Full flat attribute schema from v1 Chart block",
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"required": ["type"],
				"properties": {
					"type": {
						"type": "string",
						"enum": [
							"string",
							"number",
							"integer",
							"boolean",
							"object",
							"array"
						]
					},
					"default": {
						"description": "Default value for the attribute"
					},
					"enum": {
						"description": "Allowed values for string/number enums",
						"type": "array"
					}
				}
			}
		},
		"supports": {
			"description": "Block supports configuration",
			"type": "object",
			"properties": {
				"html": {
					"type": "boolean",
					"const": false
				},
				"inserter": {
					"type": "boolean",
					"const": false
				},
				"interactivity": {
					"type": "boolean"
				}
			}
		},
		"save": {
			"description": "Function that returns the saved block markup for v1 flat attributes",
			"type": "string",
			"const": "function"
		},
		"migrate": {
			"description": "Function that transforms flat attributes to nested structure",
			"type": "string",
			"const": "function"
		},
		"isEligible": {
			"description": "Optional function to determine if this deprecation should be attempted",
			"type": "string",
			"const": "function"
		}
	},
	"definitions": {
		"migrateFunction": {
			"description": "Signature for the migrate function",
			"parameters": [
				{
					"name": "attributes",
					"type": "object",
					"description": "Flat v1 attributes to be transformed"
				}
			],
			"returns": {
				"type": "object",
				"description": "Nested v2 attributes",
				"required": ["_version", "layout", "io"],
				"properties": {
					"_version": {
						"type": "string",
						"const": "v2"
					},
					"layout": {
						"$ref": "#/definitions/layoutObject"
					},
					"metadata": {
						"$ref": "#/definitions/metadataObject"
					},
					"colors": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^#[0-9A-Fa-f]{6}$"
						}
					},
					"plotBands": {
						"$ref": "#/definitions/plotBandsObject"
					},
					"independentAxis": {
						"$ref": "#/definitions/axisObject"
					},
					"dependentAxis": {
						"$ref": "#/definitions/axisObject"
					},
					"dataRender": {
						"type": "object"
					},
					"animate": {
						"type": "object"
					},
					"tooltip": {
						"type": "object"
					},
					"legend": {
						"type": "object"
					},
					"labels": {
						"type": "object"
					},
					"bar": {
						"type": "object"
					},
					"line": {
						"type": "object"
					},
					"dotPlot": {
						"type": "object"
					},
					"explodedBar": {
						"type": "object"
					},
					"pie": {
						"type": "object"
					},
					"nodes": {
						"type": "object"
					},
					"map": {
						"type": "object"
					},
					"divergingBar": {
						"type": "object"
					},
					"diffColumn": {
						"type": "object"
					},
					"annotations": {
						"type": "object"
					},
					"custom": {
						"type": "object"
					},
					"io": {
						"$ref": "#/definitions/ioObject"
					},
					"_legacy": {
						"type": "object",
						"description": "Deprecated attributes with no mapping"
					}
				}
			}
		},
		"layoutObject": {
			"type": "object",
			"required": ["type", "width", "height"],
			"properties": {
				"name": {
					"type": "string"
				},
				"parentClass": {
					"type": ["string", "null"]
				},
				"type": {
					"type": "string",
					"enum": [
						"bar",
						"diverging-bar",
						"line",
						"area",
						"scatter",
						"pie",
						"dot-plot",
						"stacked-bar",
						"grouped-bar",
						"exploded-bar",
						"stacked-area",
						"map-usa",
						"map-usa-counties",
						"map-usa-block",
						"map-world",
						"freeform"
					]
				},
				"orientation": {
					"type": "string",
					"enum": ["vertical", "horizontal"]
				},
				"width": {
					"type": "integer",
					"minimum": 1
				},
				"height": {
					"type": "integer",
					"minimum": 1
				},
				"padding": {
					"type": "object",
					"required": ["top", "right", "bottom", "left"],
					"properties": {
						"top": {
							"type": "integer"
						},
						"right": {
							"type": "integer"
						},
						"bottom": {
							"type": "integer"
						},
						"left": {
							"type": "integer"
						}
					}
				},
				"overflowX": {
					"type": "string",
					"enum": [
						"scroll",
						"responsive",
						"scroll-fixed-y-axis",
						"preserve-aspect-ratio"
					]
				},
				"horizontalRules": {
					"type": "boolean"
				},
				"mobileBreakpoint": {
					"type": "integer"
				}
			}
		},
		"metadataObject": {
			"type": "object",
			"properties": {
				"active": {
					"type": "boolean"
				},
				"title": {
					"type": "string"
				},
				"subtitle": {
					"type": "string"
				},
				"note": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"tag": {
					"type": "string"
				},
				"alt": {
					"type": "string"
				}
			}
		},
		"plotBandsObject": {
			"type": "object",
			"properties": {
				"active": {
					"type": "boolean"
				},
				"allowDrag": {
					"type": "boolean"
				},
				"allowResize": {
					"type": "boolean"
				},
				"dimension": {
					"type": "string",
					"enum": ["x", "y"]
				},
				"bands": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"from": {
								"type": "number"
							},
							"to": {
								"type": "number"
							},
							"color": {
								"type": "string"
							},
							"label": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"axisObject": {
			"type": "object",
			"properties": {
				"active": {
					"type": "boolean"
				},
				"label": {
					"type": "string"
				},
				"scale": {
					"type": "string",
					"enum": ["linear", "time", "log", "sqrt"]
				},
				"domain": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 2,
					"maxItems": 2
				},
				"tickCount": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"ioObject": {
			"type": "object",
			"description": "WordPress-specific block metadata",
			"properties": {
				"id": {
					"type": "string"
				},
				"parentClass": {
					"type": "string"
				},
				"isConvertedChart": {
					"type": "boolean"
				},
				"isStaticChart": {
					"type": "boolean"
				},
				"isFreeformChart": {
					"type": "boolean"
				},
				"staticImageId": {
					"type": "string"
				},
				"staticImageUrl": {
					"type": "string"
				},
				"staticImageInnerHTML": {
					"type": "string"
				},
				"chartConverted": {
					"type": "object",
					"properties": {
						"converted": {
							"type": "boolean"
						},
						"requester": {
							"type": "string"
						},
						"timestamp": {
							"type": "string"
						}
					}
				},
				"defaultShouldRender": {
					"type": "boolean"
				},
				"lock": {
					"type": "object",
					"properties": {
						"move": {
							"type": "boolean"
						},
						"remove": {
							"type": "boolean"
						}
					}
				}
			}
		}
	},
	"examples": [
		{
			"description": "Example v1 flat attributes",
			"value": {
				"chartType": "bar",
				"width": 640,
				"height": 400,
				"xAxisActive": true,
				"xLabel": "Years",
				"yAxisActive": true,
				"yLabel": "Values"
			}
		},
		{
			"description": "Expected v2 nested output after migration",
			"value": {
				"_version": "v2",
				"layout": {
					"type": "bar",
					"width": 640,
					"height": 400
				},
				"independentAxis": {
					"active": true,
					"label": "Years"
				},
				"dependentAxis": {
					"active": true,
					"label": "Values"
				}
			}
		}
	]
}
