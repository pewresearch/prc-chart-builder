{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://pewresearch.org/schemas/chart-block-test-fixture.json",
	"title": "Chart Block Test Fixture Format",
	"description": "Schema for test fixtures that validate WordPress block deprecation migrations",
	"type": "object",
	"required": [
		"name",
		"description",
		"blockVersion",
		"serializedContent",
		"expectedMigratedAttributes"
	],
	"properties": {
		"name": {
			"type": "string",
			"description": "Unique identifier for this fixture (e.g., v1-basic-bar-chart)",
			"pattern": "^v[0-9]+-[a-z0-9-]+$"
		},
		"description": {
			"type": "string",
			"description": "Human-readable description of what this fixture tests"
		},
		"blockVersion": {
			"type": "string",
			"description": "Block version this fixture represents",
			"enum": ["v1", "v2"]
		},
		"chartType": {
			"type": "string",
			"description": "Type of chart being tested",
			"enum": [
				"bar",
				"diverging-bar",
				"line",
				"area",
				"pie",
				"dot-plot",
				"stacked-bar",
				"grouped-bar",
				"exploded-bar",
				"map-usa",
				"map-usa-counties",
				"map-world"
			]
		},
		"featureTags": {
			"type": "array",
			"description": "Features being tested in this fixture",
			"items": {
				"type": "string",
				"enum": [
					"legend",
					"tooltip",
					"annotations",
					"plot-bands",
					"custom-colors",
					"axis-configuration",
					"data-labels",
					"wordpress-metadata",
					"minimal-config",
					"maximal-config",
					"edge-case"
				]
			}
		},
		"serializedContent": {
			"type": "string",
			"description": "WordPress block serialized format (HTML comment + content). This is what's stored in post_content.",
			"pattern": "^<!-- wp:prc-chart-builder/chart.*-->"
		},
		"originalAttributes": {
			"type": "object",
			"description": "Optional: Flat v1 attributes for reference (not used in test, but helpful for documentation)"
		},
		"expectedMigratedAttributes": {
			"type": "object",
			"description": "Expected nested v2 attributes after migration",
			"required": ["_version"],
			"properties": {
				"_version": {
					"type": "string",
					"const": "v2"
				},
				"layout": {
					"type": "object"
				},
				"metadata": {
					"type": "object"
				},
				"independentAxis": {
					"type": "object"
				},
				"dependentAxis": {
					"type": "object"
				},
				"io": {
					"type": "object"
				},
				"id": {
					"type": "string"
				}
			}
		},
		"validationRules": {
			"type": "object",
			"description": "Optional: Additional validation rules for this fixture",
			"properties": {
				"mustNotHave": {
					"type": "array",
					"description": "Attribute paths that should NOT exist after migration",
					"items": {
						"type": "string"
					},
					"examples": [["xAxisActive", "yLabel", "tooltipActive"]]
				},
				"mustHave": {
					"type": "array",
					"description": "Attribute paths that MUST exist after migration",
					"items": {
						"type": "string"
					},
					"examples": [
						["layout.type", "independentAxis.active", "id"]
					]
				},
				"legacyAttributesExpected": {
					"type": "array",
					"description": "Attributes that should end up in _legacy object",
					"items": {
						"type": "string"
					}
				},
				"dataLossCheck": {
					"type": "boolean",
					"description": "If true, verify total data points unchanged after migration",
					"default": true
				}
			}
		},
		"notes": {
			"type": "string",
			"description": "Additional notes about this fixture, special considerations, or known issues"
		}
	},
	"examples": [
		{
			"name": "v1-basic-bar-chart",
			"description": "Simple vertical bar chart with minimal configuration",
			"blockVersion": "v1",
			"chartType": "bar",
			"featureTags": ["minimal-config"],
			"serializedContent": "<!-- wp:prc-chart-builder/chart {\"chartType\":\"bar\",\"width\":640,\"height\":400,\"xAxisActive\":true,\"xLabel\":\"Years\",\"yAxisActive\":true,\"yLabel\":\"Values\",\"customColors\":[\"#436983\",\"#bf3927\"]} -->\\n<div class=\"wp-block-prc-chart-builder-chart\"></div>\\n<!-- /wp:prc-chart-builder/chart -->",
			"originalAttributes": {
				"chartType": "bar",
				"width": 640,
				"height": 400,
				"xAxisActive": true,
				"xLabel": "Years",
				"yAxisActive": true,
				"yLabel": "Values",
				"customColors": ["#436983", "#bf3927"]
			},
			"expectedMigratedAttributes": {
				"_version": "v2",
				"layout": {
					"type": "bar",
					"orientation": "vertical",
					"width": 640,
					"height": 400
				},
				"independentAxis": {
					"active": true,
					"label": "Years"
				},
				"dependentAxis": {
					"active": true,
					"label": "Values"
				},
				"colors": ["#436983", "#bf3927"]
			},
			"validationRules": {
				"mustNotHave": ["chartType", "xAxisActive", "yLabel"],
				"mustHave": [
					"layout.type",
					"independentAxis.active",
					"dependentAxis.label"
				],
				"dataLossCheck": true
			}
		},
		{
			"name": "v1-line-with-legend-and-tooltip",
			"description": "Line chart with legend and custom tooltip configuration",
			"blockVersion": "v1",
			"chartType": "line",
			"featureTags": ["legend", "tooltip"],
			"serializedContent": "<!-- wp:prc-chart-builder/chart {\"chartType\":\"line\",\"legendActive\":true,\"legendCategories\":[\"Series A\",\"Series B\"],\"tooltipActive\":true,\"tooltipFormat\":\"{{row}}: {{value}}%\"} -->\\n<div class=\"wp-block-prc-chart-builder-chart\"></div>\\n<!-- /wp:prc-chart-builder/chart -->",
			"expectedMigratedAttributes": {
				"_version": "v2",
				"layout": {
					"type": "line"
				},
				"legend": {
					"active": true,
					"categories": ["Series A", "Series B"]
				},
				"tooltip": {
					"active": true,
					"format": "{{row}}: {{value}}%"
				}
			},
			"validationRules": {
				"mustHave": [
					"legend.active",
					"legend.categories",
					"tooltip.active"
				]
			}
		},
		{
			"name": "v1-wordpress-metadata-only",
			"description": "Chart with only WordPress-specific metadata (should go to io object)",
			"blockVersion": "v1",
			"chartType": "bar",
			"featureTags": ["wordpress-metadata", "edge-case"],
			"serializedContent": "<!-- wp:prc-chart-builder/chart {\"chartType\":\"bar\",\"isStaticChart\":true,\"staticImageUrl\":\"https://example.com/chart.png\",\"isFreeformChart\":false} -->\\n<div class=\"wp-block-prc-chart-builder-chart\"></div>\\n<!-- /wp:prc-chart-builder/chart -->",
			"expectedMigratedAttributes": {
				"_version": "v2",
				"io": {
					"isStaticChart": true,
					"staticImageUrl": "https://example.com/chart.png",
					"isFreeformChart": false
				}
			},
			"validationRules": {
				"mustHave": ["io.isStaticChart", "io.staticImageUrl"],
				"mustNotHave": ["isStaticChart", "staticImageUrl"]
			},
			"notes": "Tests that WordPress-specific metadata is correctly separated into io object"
		}
	]
}
