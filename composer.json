{
	"name": "prc/chart-builder",
	"description": "Chart Builder is a chart building tool for the PRC Platform",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"automattic/jetpack-autoloader": "^5.0",
		"prc/wp-html-processors": "^1.0",
		"prc/block-utils": "^1.1",
		"screenshotone/sdk": "^1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^1.0",
		"wp-phpunit/wp-phpunit": "^6.1"
	},
	"scripts": {
		"test": [
			"phpunit --configuration ../../tests/prc-chart-builder/phpunit/phpunit.xml.dist"
		],
		"test-ms": [
			"WP_MULTISITE=1 phpunit --configuration ../../tests/prc-chart-builder/phpunit/phpunit.xml.dist"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"automattic/jetpack-autoloader": true
		},
		"platform": {
			"php": "8.4.0"
		}
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/pewresearch/wp-html-processors"
		},
		{
			"type": "vcs",
			"url": "https://github.com/pewresearch/prc-block-utils"
		}
	]
}
