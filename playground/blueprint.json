{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"constants": {
		"WP_PLAYGROUND": true
	},
	"siteOptions": {
		"blogname": "PRC Chart Builder Playground",
		"blogdescription": "A playground for testing PRC Chart Builder",
		"WPLANG": "en_US"
	},
	"landingPage": "/wp-admin/post-new.php?post_type=chart",
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/pewresearch/prc-scripts",
				"ref": "trunk",
				"refType": "branch"
			},
			"options": {
				"targetFolderName": "prc-scripts",
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/pewresearch/prc-post-publish-pipeline",
				"ref": "trunk",
				"refType": "branch"
			},
			"options": {
				"targetFolderName": "prc-post-publish-pipeline",
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/pewresearch/prc-block-tables",
				"ref": "trunk",
				"refType": "branch"
			},
			"options": {
				"targetFolderName": "prc-block-tables",
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/pewresearch/prc-charting-library",
				"ref": "trunk",
				"refType": "branch"
			},
			"options": {
				"targetFolderName": "prc-charting-library",
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/pewresearch/prc-chart-builder",
				"ref": "trunk",
				"refType": "branch"
			},
			"options": {
				"targetFolderName": "prc-chart-builder",
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; flush_rewrite_rules();"
		}
	]
}
